# Lumen runs fully in "demo mode" without any of these variables —
# data is stored locally in your browser and a seeded demo account is included.
# Add the values below to connect Supabase (PostgreSQL) as the real backend.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: LLM-powered Copilot (falls back to the built-in local analysis engine)
OPENAI_API_KEY=